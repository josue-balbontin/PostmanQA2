{
  "name": "appiumwdiopom",
  "version": "1.0.0",
  "description": "Proyecto de automatización móvil con WebdriverIO, Appium, POM y Cucumber (App Reloj Android DeskClock)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "wdio run ./wdio.conf.js",
    "test": "wdio run ./wdio.conf.js",
    "test:cucumber": "wdio run ./wdio.conf.js",
    "test:addAlarm": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@addAlarm\"",
    "test:cancelAlarm": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@cancelAlarm\"",
    "test:deleteAlarm": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@deleteAlarm\"",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "wdio": "wdio run ./wdio.conf.js",
    "clean:allure": "rimraf allure-results"
  },
  "keywords": [
    "webdriverio",
    "cucumber",
    "appium",
    "pom",
    "android",
    "deskclock"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/browserstack-service": "^9.36.2",
    "@wdio/cli": "^9.31.5",
    "@wdio/cucumber-framework": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.46.1",
    "appium-uiautomator2-driver": "^8.7.0",
    "rimraf": "^6.1.3"
  }
}
