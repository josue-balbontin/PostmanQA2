{
  "name": "examen-biblioteca-qa",
  "version": "1.0.0",
  "description": "Proyecto WebdriverIO BDD con POM y Allure Reporter para Biblioteca QA",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:inciso1": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@inciso1\"",
    "test:inciso2": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@inciso2\"",
    "test:inciso3": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@inciso3\"",
    "test:inciso4": "wdio run ./wdio.conf.js --cucumberOpts.tagExpression=\"@inciso4\"",
    "clean:allure": "rimraf allure-results",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.5",
    "@wdio/cucumber-framework": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.43.0",
    "rimraf": "^6.1.3"
  }
}
